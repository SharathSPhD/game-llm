\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Warm-started equilibrium decoding reduces solver iterations per token from 7.91 (cold-start) to 1.64 (warm-started), a 79.3\% reduction (F19). Greedy-token agreement is 97.6\% across 1000 tokens (39/40 sequences exact match). The TRIZ P10 prediction holds: sequential equilibria are close, allowing efficient warm-started inference.}}{25}{figure.caption.24}\protected@file@percent }
\newlabel{fig:warm_start}{{9}{25}{Warm-started equilibrium decoding reduces solver iterations per token from 7.91 (cold-start) to 1.64 (warm-started), a 79.3\% reduction (F19). Greedy-token agreement is 97.6\% across 1000 tokens (39/40 sequences exact match). The TRIZ P10 prediction holds: sequential equilibria are close, allowing efficient warm-started inference}{figure.caption.24}{}}
