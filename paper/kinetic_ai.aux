\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces H1 iteration-by-iteration progression at 11M parameters (F17--F18 verdict), showing ratio (EqLM BLiMP / explicit BLiMP) across three seeds (42/43/44). Iteration 1 baseline with v1 residual (0.78 ratio) $\to $ iteration 2 with v3 post-LN (0.93 ratio near-miss) $\to $ iteration 3 three-seed verdict (0.9303 mean ratio, CI $[0.8979, 0.9492]$). Each iteration's fix addresses a diagnosed defect: initialization scaling, then fixed-point map topology, then weak contraction. Bootstrap 95\% CI bands shown; all seeds within plotted range.}}{24}{figure.caption.23}\protected@file@percent }
\newlabel{fig:h1_iterations}{{8}{24}{H1 iteration-by-iteration progression at 11M parameters (F17--F18 verdict), showing ratio (EqLM BLiMP / explicit BLiMP) across three seeds (42/43/44). Iteration 1 baseline with v1 residual (0.78 ratio) $\to $ iteration 2 with v3 post-LN (0.93 ratio near-miss) $\to $ iteration 3 three-seed verdict (0.9303 mean ratio, CI $[0.8979, 0.9492]$). Each iteration's fix addresses a diagnosed defect: initialization scaling, then fixed-point map topology, then weak contraction. Bootstrap 95\% CI bands shown; all seeds within plotted range}{figure.caption.23}{}}
