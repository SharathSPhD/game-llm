# Supabase configuration (optional; auth softly disables if unset)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gateway configuration (backend API)
# When unset, app enters REPLAY_MODE and serves canned demo data
GATEWAY_URL=http://localhost:8000
GATEWAY_SECRET=dev-secret

# Optional: override default port and host
NODE_ENV=development
